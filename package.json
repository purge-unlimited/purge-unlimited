{
  "name": "dsh-purge-unlimited",
  "version": "2.1.0",
  "type": "module",
  "description": "Deliverable-first execution policy for DeepSeek Harness, plus a provider-neutral adapter layer (OpenAI / DeepSeek / Anthropic / Gemini / Ollama / any OpenAI-compatible endpoint). 22-component behavior contract injected into every session's system prompt, with standalone assembly, recovery routing, anchor gating, probe scoring, and one target boundary that changes only how a target is written, never how deep the answer goes.",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./adapters": "./lib/adapters.mjs",
    "./config": "./lib/config.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "SKILL.md",
    "references",
    "presets",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check-armor.mjs",
    "test": "node tests/run.mjs",
    "verify": "node scripts/check-armor.mjs && node tests/run.mjs",
    "demo:router": "node scripts/router.mjs --demo",
    "demo:anchor": "node scripts/anchor-gate.mjs --demo",
    "demo:score": "node scripts/score.mjs --selftest",
    "assemble": "node scripts/assemble.mjs --preset claude-sonnet --with-policy --out build/prompt.md",
    "assemble:stdout": "node scripts/assemble.mjs --preset claude-sonnet --with-policy --stdout",
    "export:all": "node scripts/export.mjs --provider all --dir build/adapters",
    "probe": "node scripts/probe.mjs --dry-run",
    "pack": "npm pack"
  },
  "keywords": [
    "dsh",
    "agent",
    "agent-skill",
    "llm",
    "llm-agents",
    "prompt",
    "prompt-engineering",
    "system-prompt",
    "codex",
    "deepseek",
    "openai",
    "anthropic",
    "purge",
    "armor",
    "uncensored",
    "unrestricted",
    "red-team",
    "prompt-injection",
    "prompt-hacking",
    "jailbreak-research"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purge-unlimited/purge-unlimited.git"
  },
  "homepage": "https://github.com/purge-unlimited/purge-unlimited#readme",
  "bugs": {
    "url": "https://github.com/purge-unlimited/purge-unlimited/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
